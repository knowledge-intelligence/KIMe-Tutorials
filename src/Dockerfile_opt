# ROS2 Humble이 이미 설치되어 있는 공식 이미지를 그대로 사용
# (nvidia/cuda 베이스 + ROS2 수동 설치 과정 불필요)
#
# ★ GPU 실행 주의 ★
# ros:jazzy 은 CUDA 이미지가 아니므로, GPU 를 쓰려면 다음이 모두 필요하다.
#   1) 호스트에 NVIDIA 드라이버 + nvidia-container-toolkit 설치
#   2) 컨테이너를 반드시 --gpus all 로 실행
#        예) docker run --gpus all ...
#   토치(+cuXXX 빌드)가 자체 CUDA 런타임을 포함하므로, 위 두 조건만 맞으면
#   베이스가 ros:jazzy 이어도 torch.cuda.is_available() == True 가 된다.
FROM ros:jazzy
# FROM osrf/ros:jazzy-desktop-full

ENV DEBIAN_FRONTEND=noninteractive

# 이 패키지(ament_python)를 빌드/실행하는 데 실제로 필요한 패키지만 설치
# (git, wget: 빌드 시점에 yolov5 소스/가중치를 받기 위해 추가)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip \
    git \
    wget \
    python3-colcon-common-extensions \
    ros-jazzy-cv-bridge \
    ros-jazzy-rmw-cyclonedds-cpp \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --break-system-packages -U ultralytics "numpy<2" pandas tqdm seaborn scipy

# ---------------------------------------------------------------------------
# 실행 시 인터넷에서 저장소/가중치를 받는 문제를 없애기 위해,
# yolov5 소스 저장소와 사전학습 가중치를 "빌드 시점"에 미리 준비한다.
# 노드 코드는 이 경로(YOLOV5_REPO / YOLOV5_WEIGHTS)를 source='local' 로 로드한다.
# ---------------------------------------------------------------------------
ENV YOLOV5_REPO=/app/yolov5
ENV YOLOV5_WEIGHTS=/app/yolov5s.pt
RUN git clone --depth 1 https://github.com/ultralytics/yolov5 ${YOLOV5_REPO} && \
    wget -q https://github.com/ultralytics/yolov5/releases/download/v7.0/yolov5s.pt \
        -O ${YOLOV5_WEIGHTS}

# create a basic workspace
WORKDIR /app/kime_ws

COPY ./In_Docker /app/kime_ws/ROS2_Yolov5_Docker
RUN colcon build

RUN echo 'source /opt/ros/jazzy/setup.bash' >> ~/.bashrc && \
    echo 'source /app/kime_ws/install/setup.bash' >> ~/.bashrc

ENV ROS_DOMAIN_ID=1
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ENV PYTHONWARNINGS="ignore::FutureWarning"

# begin the node
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
CMD ["ros2", "run", "ros2_yolov5_docker", "ros2_yolov5_docker_node"]