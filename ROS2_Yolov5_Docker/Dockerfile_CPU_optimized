# GPU 없이 CPU만으로 yolov5를 테스트하기 위한 이미지
# ROS2 Foxy가 이미 설치되어 있는 이미지를 그대로 사용 (ROS2 수동 설치 불필요)
FROM shaderobotics/ros:foxy

ENV DEBIAN_FRONTEND=noninteractive

# create a basic workspace
WORKDIR /app/kime_ws

# 이 패키지(ament_python)를 빌드/실행하는 데 실제로 필요한 패키지만 설치
RUN apt-get update && apt-get install -y --no-install-recommends \
    libsm6 \
    libxext6 \
    python3-pip \
    ros-foxy-cv-bridge \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir -U pip && \
    pip3 install --no-cache-dir -U ultralytics "numpy<2"

COPY ./In_Docker /app/kime_ws/ROS2_Yolov5_Docker
COPY ./In_Docker/yolov5s.pt /app/kime_ws/
RUN pip install --upgrade "packaging>=22.0"
RUN colcon build

ENV PYTHONWARNINGS="ignore::FutureWarning"

# begin the node
ENTRYPOINT ["/bin/bash", "-c", "source /opt/ros/foxy/setup.bash && source install/setup.bash && export ROS_DOMAIN_ID=1 && ros2 run ros2_yolov5_docker ros2_yolov5_docker_node"]
CMD ["bash"]
